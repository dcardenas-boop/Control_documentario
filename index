function isHabilitado(r){ return HAB_VALUES.includes(r.estado); }

function estadoBadgeClass(estado){
  if(estado === 'Habilitado') return 'ok';
  if(estado === 'Suspendido' || estado === 'Baja') return 'warn';
  return 'bad';
}

function populateSelect(sel, values, placeholder){
  sel.innerHTML = '<option value="">' + placeholder + '</option>';
  values.forEach(v => {
    const opt = document.createElement('option');
    opt.value = v; opt.textContent = v;
    sel.appendChild(opt);
  });
}

function uniqueVals(data, key){
  return [...new Set(data.map(r => r[key]).filter(Boolean))].sort();
}

function refreshFilterOptions(){
  const cfg = CONFIG[state.tab];
  const estados = uniqueVals(cfg.data, 'estado');
  const col2vals = uniqueVals(cfg.data, cfg.col2Key);
  const motivos = uniqueVals(cfg.data, 'motivo');
  populateSelect(document.getElementById('filterEstado'), estados, 'Todos los estados');
  populateSelect(document.getElementById('filterCol2'), col2vals, cfg.col2Label);
  populateSelect(document.getElementById('filterMotivo'), motivos, 'Todos los motivos');
}

function getFiltered(){
  const cfg = CONFIG[state.tab];
  let rows = cfg.data;

  if(state.subfilter === 'habilitados') rows = rows.filter(isHabilitado);
  if(state.subfilter === 'no-habilitados') rows = rows.filter(r => !isHabilitado(r));

  if(state.estado) rows = rows.filter(r => r.estado === state.estado);
  if(state.col2) rows = rows.filter(r => r[cfg.col2Key] === state.col2);
  if(state.motivo) rows = rows.filter(r => r.motivo === state.motivo);

  if(state.search.trim()){
    const q = state.search.trim().toLowerCase();
    rows = rows.filter(r => cfg.searchKeys.some(k => (r[k]||'').toString().toLowerCase().includes(q)));
  }

  if(state.sortKey){
    const sk = state.sortKey;
    rows = [...rows].sort((a,b) => {
      const av = (a[sk]||'').toString().toLowerCase();
      const bv = (b[sk]||'').toString().toLowerCase();
      if(av < bv) return -1*state.sortDir;
      if(av > bv) return 1*state.sortDir;
      return 0;
    });
  }
  return rows;
}

function renderKPIs(){
  const cfg = CONFIG[state.tab];
  const data = cfg.data;
  const total = data.length;
  const hab = data.filter(isHabilitado).length;
  const inhab = total - hab;
  const pct = total ? Math.round((hab/total)*1000)/10 : 0;

  document.getElementById('kpiTotalLabel').textContent = cfg.totalLabel;
  document.getElementById('kpiTotal').textContent = total;
  document.getElementById('kpiTotalBar').style.width = '100%';
  document.getElementById('kpiHab').textContent = hab;
  document.getElementById('kpiInhabLabel').textContent = cfg.inhabLabel;
  document.getElementById('kpiInhab').textContent = inhab;
  document.getElementById('kpiPct').textContent = pct + '%';
  document.getElementById('kpiPctSub').textContent = 'Sobre el total de ' + cfg.totalLabel;
}

function renderTableHead(){
  const cfg = CONFIG[state.tab];
  const thead = document.getElementById('tableHead');
  let html = '<tr>';
  cfg.columns.forEach(c => {
    html += '<th data-key="' + (c.sortKey||c.key) + '">' + c.label + '</th>';
  });
  html += '<th>Acción</th></tr>';
  thead.innerHTML = html;
  thead.querySelectorAll('th[data-key]').forEach(th => {
    th.addEventListener('click', () => {
      const key = th.getAttribute('data-key');
      if(state.sortKey === key){ state.sortDir *= -1; } else { state.sortKey = key; state.sortDir = 1; }
      state.page = 1;
      render();
    });
  });
}

function renderCell(r, col){
  if(col.renderFn) return col.renderFn(r);
  if(col.type === 'estado'){
    return '<span class="badge ' + estadoBadgeClass(r.estado) + '">' + r.estado + '</span>';
  }
  if(col.type === 'motivo'){
    if(!r.motivo) return '<span class="motivo-tag none">—</span>';
    return '<span class="motivo-tag">' + r.motivo + '</span>';
  }
  return r[col.key] != null && r[col.key] !== '' ? r[col.key] : '<span class="cell-muted">—</span>';
}

let currentRowsCache = [];

function renderTableBody(){
  const cfg = CONFIG[state.tab];
  const rows = getFiltered();
  currentRowsCache = rows;

  document.getElementById('tableTitle').textContent =
    state.subfilter === 'no-habilitados' ? (cfg.title + ' no habilitados') :
    state.subfilter === 'habilitados' ? (cfg.title + ' habilitados') : cfg.title;
  document.getElementById('tableCount').textContent = rows.length + ' registro' + (rows.length===1?'':'s');

  const totalPages = Math.max(1, Math.ceil(rows.length / state.pageSize));
  if(state.page > totalPages) state.page = totalPages;
  const startIdx = (state.page-1)*state.pageSize;
  const pageRows = rows.slice(startIdx, startIdx+state.pageSize);

  const tbody = document.getElementById('tableBody');
  const emptyState = document.getElementById('emptyState');

  if(pageRows.length === 0){
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
  } else {
    emptyState.style.display = 'none';
    tbody.innerHTML = pageRows.map((r, idx) => {
      const realIdx = startIdx + idx;
      let tds = cfg.columns.map(c =>
        '<td class="' + (c.strong ? 'cell-strong' : '') + '">' + renderCell(r, c) + '</td>'
      ).join('');
      tds += '<td><button class="action-btn" data-idx="' + realIdx + '">Ver ficha</button></td>';
      return '<tr>' + tds + '</tr>';
    }).join('');
    tbody.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(currentRowsCache[parseInt(btn.getAttribute('data-idx'))]));
    });
  }

  document.getElementById('pageInfo').textContent = 'Página ' + state.page + ' de ' + totalPages;
  document.getElementById('prevPage').disabled = state.page <= 1;
  document.getElementById('nextPage').disabled = state.page >= totalPages;
}

function openModal(r){
  const cfg = CONFIG[state.tab];
  const title = cfg.modalTitleFn ? cfg.modalTitleFn(r) : r[cfg.modalTitleKey];
  document.getElementById('modalTitle').textContent = title;
  document.getElementById('modalSubtitle').textContent = cfg.modalSubtitleFn ? cfg.modalSubtitleFn(r) : '';

  const fieldLabels = state.tab === 'vehiculos'
    ? [['dominio','Dominio'],['marca','Marca'],['modelo','Modelo'],['estado','Estado'],['motivo','Motivo inhabilitación'],['fecha','Fecha']]
    : [['apellido','Apellido'],['nombre','Nombre'],['cuil','CUIL'],['empresa','Empresa'],['funcion','Función'],['puesto','Puesto'],['conduce','Conduce'],['estado','Estado'],['motivo','Motivo no habilitación'],['fecha','Fecha']];

  const body = document.getElementById('modalBody');
  body.innerHTML = fieldLabels.map(([key,label]) => {
    let val = r[key];
    if(key === 'estado'){
      val = '<span class="badge ' + estadoBadgeClass(r.estado) + '">' + r.estado + '</span>';
    } else if(key === 'motivo'){
      val = r.motivo ? ('<span class="motivo-tag">'+r.motivo+'</span>') : '<span class="motivo-tag none">—</span>';
    } else {
      val = (val != null && val !== '') ? val : '—';
    }
    return '<div class="modal-row"><span class="k">' + label + '</span><span class="v">' + val + '</span></div>';
  }).join('');

  document.getElementById('modalOverlay').classList.add('open');
}
document.getElementById('modalClose').addEventListener('click', () => {
  document.getElementById('modalOverlay').classList.remove('open');
});
document.getElementById('modalOverlay').addEventListener('click', (e) => {
  if(e.target.id === 'modalOverlay') document.getElementById('modalOverlay').classList.remove('open');
});

function exportCSV(){
  const cfg = CONFIG[state.tab];
  const rows = getFiltered();
  const headers = cfg.columns.map(c => c.label);
  const keys = cfg.columns.map(c => c.key);
  let csv = headers.join(';') + '\n';
  rows.forEach(r => {
    csv += keys.map(k => {
      let v = (r[k] != null ? r[k] : '').toString().replace(/;/g, ',');
      return v;
    }).join(';') + '\n';
  });
  const blob = new Blob(['\ufeff'+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = (state.tab === 'vehiculos' ? 'vehiculos' : 'personal') + '_export.csv';
  a.click();
  URL.revokeObjectURL(url);
}

function updateCounts(){
  document.getElementById('countVehiculos').textContent = VEHICULOS.length;
  document.getElementById('countPersonal').textContent = PERSONAL.length;
  const cfg = CONFIG[state.tab];
  const inhabCount = cfg.data.filter(r => !isHabilitado(r)).length;
  document.getElementById('btnNoHab').textContent = 'No habilitados';
}

function render(){
  renderKPIs();
  renderTableHead();
  renderTableBody();
}

document.getElementById('tabBtnVehiculos').addEventListener('click', () => switchTab('vehiculos'));
document.getElementById('tabBtnPersonal').addEventListener('click', () => switchTab('personal'));

function switchTab(tab){
  state.tab = tab;
  state.search=''; state.estado=''; state.col2=''; state.motivo=''; state.subfilter='todos';
  state.sortKey=null; state.sortDir=1; state.page=1;
  document.getElementById('searchInput').value='';
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.getAttribute('data-tab')===tab));
  document.querySelectorAll('.subfilter-btn').forEach(b => b.classList.toggle('active', b.getAttribute('data-filter')==='todos'));
  refreshFilterOptions();
  updateCounts();
  render();
}

document.getElementById('searchInput').addEventListener('input', e => { state.search = e.target.value; state.page=1; render(); });
document.getElementById('filterEstado').addEventListener('change', e => { state.estado = e.target.value; state.page=1; render(); });
document.getElementById('filterCol2').addEventListener('change', e => { state.col2 = e.target.value; state.page=1; render(); });
document.getElementById('filterMotivo').addEventListener('change', e => { state.motivo = e.target.value; state.page=1; render(); });
document.getElementById('btnLimpiar').addEventListener('click', () => {
  state.search=''; state.estado=''; state.col2=''; state.motivo='';
  document.getElementById('searchInput').value='';
  document.getElementById('filterEstado').value='';
  document.getElementById('filterCol2').value='';
  document.getElementById('filterMotivo').value='';
  state.page=1;
  render();
});
document.getElementById('btnExport').addEventListener('click', exportCSV);

document.querySelectorAll('.subfilter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.subfilter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.subfilter = btn.getAttribute('data-filter');
    state.page = 1;
    render();
  });
});

document.getElementById('prevPage').addEventListener('click', () => { if(state.page>1){state.page--; render();} });
document.getElementById('nextPage').addEventListener('click', () => { state.page++; render(); });

// init
refreshFilterOptions();
updateCounts();
render();
</script>
</body>
</html>
